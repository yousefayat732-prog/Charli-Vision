<Window x:Class="CharliVision.GlassMenuWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="Charli Vision — Liquid Glass" Icon="/CharliVision.ico" Width="412" Height="786"
 WindowStyle="None" AllowsTransparency="True" ResizeMode="NoResize"
 Background="Transparent" ShowInTaskbar="False" Topmost="False"
 WindowStartupLocation="Manual" SnapsToDevicePixels="True">
 <Window.Resources>
  <SolidColorBrush x:Key="GlassAccent" Color="#FF39DDE6"/>
  <SolidColorBrush x:Key="GlassAccentSoft" Color="#5539DDE6"/>
  <SolidColorBrush x:Key="GlassLine" Color="#7739DDE6"/>
  <SolidColorBrush x:Key="GlassIcon" Color="#FFE5F4FB"/>
  <SolidColorBrush x:Key="GlassIconSoft" Color="#2249C8CE"/>
  <SolidColorBrush x:Key="GlassTextPrimary" Color="#FFF2F9FA"/>
  <SolidColorBrush x:Key="GlassTextSecondary" Color="#FFB8CFD1"/>
  <SolidColorBrush x:Key="GlassTintBrush" Color="#D218252C"/>
  <Style x:Key="MenuRow" TargetType="Button">
   <Setter Property="Height" Value="27"/>
   <Setter Property="Margin" Value="0,0.5"/>
   <Setter Property="Padding" Value="6,0"/>
   <Setter Property="BorderThickness" Value="1"/>
   <Setter Property="BorderBrush" Value="Transparent"/>
   <Setter Property="Background" Value="#17070F13"/>
   <Setter Property="Foreground" Value="{DynamicResource GlassTextPrimary}"/>
   <Setter Property="Cursor" Value="Hand"/>
   <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
   <Setter Property="Template">
    <Setter.Value>
     <ControlTemplate TargetType="Button">
      <Border x:Name="Cell"
       CornerRadius="8" BorderThickness="{TemplateBinding BorderThickness}"
       BorderBrush="{TemplateBinding BorderBrush}"
       Background="{TemplateBinding Background}"
       Padding="{TemplateBinding Padding}">
       <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Stretch"/>
      </Border>
      <ControlTemplate.Triggers>
       <Trigger Property="IsMouseOver" Value="True">
        <Setter TargetName="Cell" Property="BorderBrush" Value="{DynamicResource GlassAccent}"/>
        <Setter TargetName="Cell" Property="Background" Value="{DynamicResource GlassAccentSoft}"/>
       </Trigger>
       <Trigger Property="IsPressed" Value="True">
        <Setter TargetName="Cell" Property="Background" Value="{DynamicResource GlassAccentSoft}"/>
       </Trigger>
       <Trigger Property="IsKeyboardFocused" Value="True">
        <Setter TargetName="Cell" Property="BorderBrush" Value="#EEFFFFFF"/>
       </Trigger>
      </ControlTemplate.Triggers>
     </ControlTemplate>
    </Setter.Value>
   </Setter>
  </Style>
  <Style x:Key="GlassScroll" TargetType="ScrollBar">
   <Setter Property="Width" Value="7"/>
   <Setter Property="Background" Value="#170B1619"/>
   <Setter Property="Foreground" Value="{DynamicResource GlassAccent}"/>
  </Style>
 </Window.Resources>
 <Grid Margin="13,8,13,10">
  <Border x:Name="OuterShell"
   CornerRadius="28" BorderThickness="1.4"
   BorderBrush="{DynamicResource GlassAccent}"
   Background="Transparent">
   <Border.Effect>
    <DropShadowEffect BlurRadius="17" ShadowDepth="0"
       Color="#FF0CC9D3" Opacity=".24"/>
   </Border.Effect>
   <Grid x:Name="GlassContentGrid" ClipToBounds="True">
    <Image x:Name="Backdrop" Opacity=".82" IsHitTestVisible="False" Stretch="Fill"
        SnapsToDevicePixels="True">
     <Image.Effect><BlurEffect Radius="14" RenderingBias="Performance"/></Image.Effect>
    </Image>
    <Border x:Name="GlassTint" Background="#640A2225" CornerRadius="27"
      IsHitTestVisible="False"/>
    <Grid Margin="15,7,15,8">
     <Grid.RowDefinitions>
      <RowDefinition Height="58"/>
      <RowDefinition Height="*"/>
     </Grid.RowDefinitions>
     <Grid Grid.Row="0">
      <Grid.ColumnDefinitions>
       <ColumnDefinition Width="49"/>
       <ColumnDefinition Width="*"/>
       <ColumnDefinition Width="29"/>
      </Grid.ColumnDefinitions>
      <Path Grid.ColumnSpan="3" Height="58" Width="355" IsHitTestVisible="False"
       VerticalAlignment="Top" HorizontalAlignment="Right" Opacity=".48"
       Data="M 160,57 C 220,50 259,2 355,6 L 355,23 C 295,24 271,62 160,57 Z"
       StrokeThickness="1.2" Stroke="{DynamicResource GlassAccent}"
       Fill="{DynamicResource GlassAccentSoft}"/>
     <Image Grid.Column="0" Source="/CharliVision.ico"
        Width="38" Height="38" Stretch="Uniform"
        HorizontalAlignment="Left" VerticalAlignment="Center"/>
      <StackPanel Grid.Column="1" VerticalAlignment="Center">
       <TextBlock Text="CHARLI VISION" FontSize="19.5"
        FontWeight="Black" FontFamily="Segoe UI Variable Display,Segoe UI"
        Foreground="{DynamicResource GlassTextPrimary}"/>
       <TextBlock Text="Musik · Lyrics · Visualizer"
        FontFamily="Segoe UI Variable Text,Segoe UI"
        Foreground="{DynamicResource GlassTextSecondary}" FontSize="11"/>
      </StackPanel>
      <Button Grid.Column="2" Content="×" ToolTip="Schließen"
        Click="CloseClicked" Foreground="{DynamicResource GlassIcon}" Background="Transparent"
        BorderThickness="0" FontSize="23" Cursor="Hand"/>
      <Path Grid.ColumnSpan="3" VerticalAlignment="Bottom" Margin="0,0,0,1"
        Stroke="{DynamicResource GlassLine}" StrokeThickness=".7"
        Data="M 0,0 L 358,0" Stretch="Fill" Height="1"/>
     </Grid>
     <ScrollViewer x:Name="MenuScroller" Grid.Row="1" VerticalScrollBarVisibility="Auto"
      HorizontalScrollBarVisibility="Disabled"
      PanningMode="VerticalOnly">
      <StackPanel x:Name="MenuItems" Margin="0,0,4,0"/>
     </ScrollViewer>
    </Grid>
   </Grid>
  </Border>
  <Popup x:Name="Flyout"
    AllowsTransparency="True" Placement="Custom" StaysOpen="True"
    PopupAnimation="Fade">
   <Border x:Name="FlyoutShell"
     CornerRadius="17" Padding="10"
     Background="#99102B30" BorderThickness="1.2"
     BorderBrush="{DynamicResource GlassAccent}">
    <Border.Effect>
     <DropShadowEffect Color="#FF00C8D5"
       BlurRadius="17" ShadowDepth="0" Opacity=".37"/>
    </Border.Effect>
    <StackPanel x:Name="FlyoutItems" Width="236"/>
   </Border>
  </Popup>
 </Grid>
</Window>